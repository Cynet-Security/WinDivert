[Version]
Signature = "$Windows NT$"
Class = WFPCALLOUTS
ClassGuid = {57465043-616C-6C6F-7574-5F636C617373}
Provider = %Basil%
CatalogFile = CyDivert.Cat
DriverVer = 08/08/2019,2.2.0

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
CyDivert.sys = 1

[DestinationDirs]
DefaultDestDir = 12 ; %windir%\system32\drivers
CyDivertCalloutDriver.DriverFiles = 12 ; %windir%\system32\drivers

[DefaultInstall]
OptionDesc = %Description%
CopyFiles = CyDivertCalloutDriver.DriverFiles

[DefaultInstall.Services]
AddService = %ServiceName%,,CyDivertCalloutDriver.Service

[CyDivertCalloutDriver.DriverFiles]
CyDivert.sys,,,0x00000040 ; COPYFLG_OVERWRITE_OLDER_ONLY

[CyDivertCalloutDriver.Service]
DisplayName = %ServiceName%
Description = %ServiceDesc%
ServiceType = 1  ; SERVICE_KERNEL_DRIVER
StartType = 0    ; SERVICE_BOOT_START
ErrorControl = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\CyDivert.sys

[Strings]
Basil = "Basil"
DiskName = "CyDivert Installation Disk"
Description = "CyDivert Driver"
ServiceName = "CyDivert"
ServiceDesc = "CyDivert Driver"
